rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function validPlayer(d) {
      return d.keys().hasOnly(['v', 'name', 'cats', 'recent', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 24
        && d.cats is map
        && d.recent is list && d.recent.size() <= 8
        && d.updatedAt is number;
    }

    // Egy buli résztvevői: aki bent van az appban, olvashatja őket,
    // de mindenki csak a saját számlálóját írhatja és törölheti.
    match /parties/{party}/players/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && validPlayer(request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Éves és összesített statisztika: mindenki láthatja az összesítéshez,
    // de csak a sajátját növelheti.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly(['v', 'total', 'years', 'updatedAt'])
                            && (!('total' in request.resource.data) || request.resource.data.total is map)
                            && (!('years' in request.resource.data) || request.resource.data.years is map);
    }
  }
}
